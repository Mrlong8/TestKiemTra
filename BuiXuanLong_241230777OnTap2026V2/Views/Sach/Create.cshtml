@model BuiXuanLong_241230777OnTap2026V2.Models.Sach

<div class="content">
	<div>
		<h3>Bùi Xuân Long - Thêm Sách Mới</h3>
	</div>
	<div class="row">
		<div class="col-md-5">
			<form asp-action="Create" method="post">
				<div class="mb-3">
					<label asp-for="MaTl" class="form-label">Thể Loại</label>
					<select asp-for="MaTl" class="form-select" asp-items="ViewBag.TheLoai"></select>
				</div>

				<div class="mb-3">
					<label asp-for="TenSach" class="form-label"> Tên Sách</label>
					<input asp-for="TenSach" class="form-control" />
					<span asp-validation-for="TenSach"></span>

				</div>
				<div class="mb-3">
					<label asp-for="Gia" class="form-label"> GIá </label>
					<input asp-for="Gia" class="form-control" />
					<span asp-validation-for="Gia"></span>
				</div>
				<div class="mb-3">
					<label asp-for="Anh" class="form-label"> Ảnh </label>
					<input asp-for="Anh" class="form-control" />
					<span asp-validation-for="Anh"></span>
				</div>
				<button class="btn btn-primary" type="submit">Submit</button>
			</form>

		</div>
	</div>

</div>
